# Initialization code that may require console input must go above this block
typeset -g POWERLEVEL9K_INSTANT_PROMPT=quiet # disable prompt notification
export POWERLEVEL9K_CONFIG_FILE="$XDG_CONFIG_HOME/p10k.zsh"

if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"

# export MANPATH="/usr/local/man:$MANPATH"
# export LANG=en_US.UTF-8 # manual set lang
# export ARCHFLAGS="-arch $(uname -m)" # Compilation flags
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export CARGO_BIN="$CARGO_HOME/bin"
export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export GOPATH="$XDG_DATA_HOME/go"
export ELAN_HOME="$XDG_DATA_HOME/elan"
export GOBIN="$GOPATH/bin"
export UV_CACHE_DIR="$XDG_CACHE_HOME/uv"

export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

source <(fzf --zsh)
export PATH="$HOME/.bin:$CARGO_BIN:$HOME/.local/bin:/usr/local/bin:$HOME/.diary:$GOBIN:$PATH"
export ZSH="$XDG_CONFIG_HOME/oh-my-zsh"
ZSH_THEME="powerlevel10k/powerlevel10k" # https://github.com/ohmyzsh/ohmyzsh/wiki/Themes

zstyle ':omz:update' mode auto # { disabled,  reminder }
zstyle ':omz:update' frequency 1 # days

COMPLETION_WAITING_DOTS="true" # completion '...', ="%F{yellow}waiting...%f"
CASE_SENSITIVE="true" # case-sensitive completions
# HYPHEN_INSENSITIVE="true" # hyphen-insensitive (_, -) requires case insensitive
# DISABLE_MAGIC_FUNCTIONS="true" # URL pasting messed
# DISABLE_LS_COLORS="true" # disable ls colours
# DISABLE_AUTO_TITLE="true" # auto set terminal title
# ENABLE_CORRECTION="true" # auto correction
# DISABLE_UNTRACKED_FILES_DIRTY="true"  # large repo git optim
HIST_STAMPS="yyyy-mm-dd" # "mm/dd/yyyy"|"dd.mm.yyyy"|"yyyy-mm-dd"
# ZSH_CUSTOM=/path/to/new-custom-folder

plugins=(
  git sudo history
  zsh-syntax-highlighting zsh-autosuggestions
  zoxide fzf-zsh-plugin
)
source $ZSH/oh-my-zsh.sh

###################### User configuration #######################

# Session predicates
is_ssh()       { [[ -n ${SSH_CONNECTION:-} ]]; }
is_tmux()      { [[ -n ${TMUX:-} ]]; }
is_graphical() { [[ -n ${DISPLAY:-} || -n ${WAYLAND_DISPLAY:-} ]]; }

has_go() { command -v go >/dev/null 2>&1 }
has_lake() { command -v lake >/dev/null 2>&1 }
has_cargo() { command -v cargo >/dev/null 2>&1 }
has_uv() { command -v uv >/dev/null 2>&1 }
has_elan() { command -v elan >/dev/null 2>&1 }

# Preferred editor for local and remote sessions
is_ssh       && export TERM='vt100'
is_graphical && export EDITOR='nvim'
is_tmux      && export EDITOR='vim'

# users are encouraged to define aliases within a top-level file in
# the $ZSH_CUSTOM folder, with .zsh extension.
source "$HOME/.aliases.sh"
source "$HOME/.elan/env"

eval "$(direnv hook zsh)"  # direnv
eval "$(but completions zsh)"  # git butler

[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh # customize with `p10k configure`
