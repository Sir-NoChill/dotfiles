// Ember Waybar — layout
// Floating pill bar. Module definitions live in modules.jsonc.
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 5,
    "margin-left": 8,
    "margin-right": 8,
    "margin-bottom": 0,
    "spacing": 0,
    "exclusive": true,
    "reload_style_on_change": true,

    "modules-left":   [ "group/left" ],
    "modules-center": [ "clock" ],
    "modules-right":  [ "group/right" ],

    "include": [ "~/.config/waybar/modules.jsonc" ]
}
